# Controller secrets. Copy to .env on the controller host and chmod 600.
VULTR_SERVERLESS_INFERENCE_API_KEY=
VULTR_MODEL_ID=
WORKER_URL=http://10.0.0.2:8100
WORKER_TOKEN=replace-with-a-long-random-secret
APP_ACCESS_TOKEN=replace-with-a-different-long-random-secret
# Browser guests use signed HttpOnly cookies; the access token never enters the UI.
# Opt in to public jobs only after configuring infrastructure and the exact browser origin.
PUBLIC_ANALYSIS_ENABLED=false
PUBLIC_ORIGIN=https://geoscope.example.com
APP_DATA_DIR=/data

# Public HTTPS termination belongs to the host reverse proxy/load balancer.
