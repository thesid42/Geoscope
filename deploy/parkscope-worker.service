[Unit]
Description=GeoScope isolated GIS execution worker
After=network-online.target docker.service netbird.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=parkscope
Group=parkscope
SupplementaryGroups=docker
WorkingDirectory=/opt/parkscope
EnvironmentFile=/etc/parkscope/worker.env
ExecStart=/opt/parkscope/venv/bin/uvicorn app.worker:app --host ${NETBIRD_WORKER_IP} --port 8100 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/parkscope-worker/tmp
UMask=0077

[Install]
WantedBy=multi-user.target
